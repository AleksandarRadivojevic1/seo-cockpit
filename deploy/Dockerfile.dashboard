# seo-cockpit dashboard — Next.js, reads collector/data/seo.db read-only.
#
# Build context is the REPO ROOT:
#   docker build -f deploy/Dockerfile.dashboard -t seo-cockpit-dashboard .

# ---------------------------------------------------------------- deps ------
FROM node:24-slim AS deps
WORKDIR /app

# better-sqlite3 is a native module and must be COMPILED HERE, not downloaded.
#
# Its published arm64 prebuild is linked against GLIBC 2.38, while node:24-slim
# (Debian bookworm) provides 2.36. Installing normally therefore succeeds, and
# the container then dies at request time with:
#
#   Error: /lib/aarch64-linux-gnu/libm.so.6: version `GLIBC_2.38' not found
#          (required by .../better-sqlite3/prebuilds/linux-arm64.node)
#   code: 'ERR_DLOPEN_FAILED'
#
# This is invisible on an x86 build host, where the matching prebuild loads
# fine — it only appears on the arm64 target. npm_config_build_from_source
# makes prebuild-install skip the download and build against the glibc that is
# actually present, which is what the toolchain below is for. None of it
# reaches the runtime stage.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY app/package.json app/package-lock.json ./
RUN npm ci

# `npm_config_build_from_source` alone does NOT work here, which cost a
# deploy cycle to discover. better-sqlite3 ships EVERY platform's prebuild
# inside its npm tarball, and its binding.gyp literally runs lib/binding.js to
# decide whether to compile — that check finds prebuilds/linux-arm64.node and
# reports "already prebuilt", so node-gyp skips the build entirely and the
# flag is a no-op.
#
# Removing the prebuilds directory is what forces a real compile. It is safe
# because lib/index.js resolves through getBinding(), which falls back to
# build/Release/better_sqlite3.node when no prebuild is present. (Only the
# platform subpath exports, e.g. `better-sqlite3/linux-arm64`, hard-require the
# prebuild — we import the package root, so the fallback applies.)
RUN rm -rf node_modules/better-sqlite3/prebuilds \
    && npm rebuild better-sqlite3 --build-from-source \
    && test -f node_modules/better-sqlite3/build/Release/better_sqlite3.node \
    && echo "better-sqlite3 compiled against local glibc"

# --------------------------------------------------------------- build ------
FROM node:24-slim AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY app/ ./

# Telemetry off: this builds on a home server, and a build should not phone
# home. SEO_DB_PATH is deliberately NOT set — every page is dynamic, so the
# build must never open the database. If a future change makes a page try to
# read at build time, `next build` will fail loudly here rather than baking a
# snapshot of the data into the image.
ENV NEXT_TELEMETRY_DISABLED=1

# Escape hatch for the 4GB Pi: `next build` is the memory-hungry step and the
# device runs a full Home Assistant stack alongside it. Empty by default so the
# build is unconstrained where memory is plentiful.
#   docker compose build --build-arg NODE_OPTIONS=--max-old-space-size=1536 ...
ARG NODE_OPTIONS=""
ENV NODE_OPTIONS=${NODE_OPTIONS}

RUN npm run build

# ------------------------------------------------------------- runtime ------
FROM node:24-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    CHROMIUM_PATH=/usr/bin/chromium

# Chromium is the PDF renderer for the Serbian client report
# (/site/<slug>/report/pdf). It is genuinely a runtime dependency, not a
# build tool: the route prints the live report page, so the browser has to be
# in the final image.
#
# This is the largest single cost in the image and it buys one thing — a real
# downloaded file instead of the browser's print dialog, which no web API can
# bypass. MEASURED on arm64 2026-07-27: the image goes 403MB -> 1.37GB, so
# chromium costs ~970MB, not the ~330MB that `du /usr/lib/chromium` suggests —
# that number omits the dependency tree (gtk, pango, cairo, mesa, x11). Puppeteer/Playwright would vendor a
# SECOND copy of the same browser, so the system package is what we drive;
# lib/report/pdf.ts spawns it directly and needs no npm dependency at all.
#
# No font package is installed on purpose: the report's only typeface is
# Geist, self-hosted by next/font out of .next/static and embedded into the
# PDF, which was verified with `pdffonts` to be the sole font in the output.
# If a future page uses a glyph Geist lacks, the symptom is tofu boxes in the
# PDF and the fix is `fonts-dejavu-core` here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium \
    && rm -rf /var/lib/apt/lists/* \
    && test -x "$CHROMIUM_PATH"

# Fixed uid so the read-only data mount can be reasoned about on the host.
RUN useradd --uid 10002 --create-home --shell /usr/sbin/nologin dashboard

# The standalone server does not include public/ or .next/static — those are
# copied in explicitly, per Next's output-tracing docs.
COPY --from=builder --chown=dashboard:dashboard /app/.next/standalone ./
COPY --from=builder --chown=dashboard:dashboard /app/.next/static ./.next/static
COPY --from=builder --chown=dashboard:dashboard /app/public ./public

USER dashboard
EXPOSE 3000

# SEO_DB_PATH must be supplied at run time and point at the mounted database.
# lib/db.ts opens it { readonly: true, fileMustExist: true } and throws a clear
# error if the variable is missing, so a misconfigured container fails fast.
CMD ["node", "server.js"]
